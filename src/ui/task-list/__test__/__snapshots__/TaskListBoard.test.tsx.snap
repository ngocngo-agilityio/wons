              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="w-full md:w-1/4 flex-grow"
        data-rfd-droppable-context-id=":ra:"
        data-rfd-droppable-id="In Progress"
      >
        <h2
          aria-level="2"
          class="font-bold font-dm-sans text-blue-800 dark:text-white text-5xl text-base md:text-xl lg:text-2xl text-blue-400 dark:text-gray-850 font-bold mb-6"
        >
          In Progress
        </h2>
        <div
          class="space-y-4 max-h-[calc(100vh-300px)] overflow-auto"
        />
      </div>
      <div
        class="w-full md:w-1/4 flex-grow"
        data-rfd-droppable-context-id=":ra:"
        data-rfd-droppable-id="In Review"
      >
        <h2
          aria-level="2"
          class="font-bold font-dm-sans text-blue-800 dark:text-white text-5xl text-base md:text-xl lg:text-2xl text-blue-400 dark:text-gray-850 font-bold mb-6"
        >
          In Review
        </h2>
        <div
          class="space-y-4 max-h-[calc(100vh-300px)] overflow-auto"
        />
      </div>
      <div
        class="w-full md:w-1/4 flex-grow"
        data-rfd-droppable-context-id=":ra:"
        data-rfd-droppable-id="Done"
      >
        <h2
          aria-level="2"
          class="font-bold font-dm-sans text-blue-800 dark:text-white text-5xl text-base md:text-xl lg:text-2xl text-blue-400 dark:text-gray-850 font-bold mb-6"
        >
          Done
        </h2>
        <div
          class="space-y-4 max-h-[calc(100vh-300px)] overflow-auto"
        />
      </div>
    </div>
  </div>
</div>
`;
